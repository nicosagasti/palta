<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Solo para NotifyIcon (bandeja). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Palta</AssemblyName>
    <RootNamespace>Palta.App</RootNamespace>
    <ApplicationIcon>Assets\palta.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <!-- LibraryImport genera código unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ThemeMode (Fluent) de WPF todavía está marcado como experimental. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms y WPF chocan en nombres (Application, MessageBox…): no los importamos globalmente. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\palta.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Palta.Core\Palta.Core.csproj" />
  </ItemGroup>
</Project>
